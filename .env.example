# Aesthra Environment Configuration (Optional)
# Aesthra works locally without any external API keys.

# Override the workspace root directory (defaults to searching upward for aesthra root or CWD)
# AESTHRA_HOME=.

# Optional future vision analyzer identifier (not required for MVP; leave unset for offline mode)
# AESTHRA_VISION_PROVIDER=

# Optional provider API keys (never commit populated .env files)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional explicit paths to ffmpeg / ffprobe binaries if not on PATH
# FFMPEG_PATH=
# FFPROBE_PATH=

